# Copy this file to .env and adjust as needed.
# All values below are safe local/demo placeholders — never real secrets.

# --- PostgreSQL (used by docker-compose to init the postgres:16-alpine container) ---
POSTGRES_DB=ias_disbursements
POSTGRES_USER=ias_app
POSTGRES_PASSWORD=demo-local-password-change-me

# --- Backend (apps/api) ---
# Must match the POSTGRES_* values above when run via docker-compose.
DATABASE_URL=postgres://ias_app:demo-local-password-change-me@localhost:5432/ias_disbursements

# Symmetric secret used to sign/verify JWTs. Local/demo value only — never reuse in production.
JWT_SECRET=demo-local-jwt-signing-secret-change-me
JWT_EXPIRES_IN=8h

PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- Frontend (apps/web) ---
# Only needed if not using the nginx same-origin proxy (e.g. local `vite dev`).
VITE_API_URL=http://localhost:3000
